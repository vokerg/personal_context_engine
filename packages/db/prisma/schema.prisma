generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// PostgreSQL is a replayable projection, never an independently editable
// source of personal notes. IDs and source metadata come from validated v1.
model Capture {
  id            String   @id @db.VarChar(36)
  capturedAt    DateTime @db.Timestamptz(3)
  capturedAtRaw String   @db.VarChar(40)
  source        String   @db.VarChar(32)
  timezone      String?  @db.VarChar(128)
  originalInput String   @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  notes         Note[]

  @@map("captures")
}

enum ImportState {
  PERSISTED
  FINALIZED
  REJECTED
  RETRY
}

model Note {
  id              String       @id @db.VarChar(36)
  ownerSubject    String?      @db.VarChar(128)
  captureId       String       @db.VarChar(36)
  capture         Capture      @relation(fields: [captureId], references: [id], onDelete: Restrict)
  schemaVersion   Int
  capturedAt      DateTime     @db.Timestamptz(3)
  capturedAtRaw   String       @db.VarChar(40)
  source          String       @db.VarChar(32)
  title           String       @db.VarChar(200)
  kind            String       @db.VarChar(32)
  domains         String[]     @default([])
  projects        String[]     @default([])
  tags            String[]     @default([])
  relatedNoteIds  String[]     @default([])
  actionHint      String       @db.VarChar(32)
  reviewRequired  Boolean
  occurredAt      DateTime?    @db.Timestamptz(3)
  occurredAtRaw   String?      @db.VarChar(40)
  dueAt           DateTime?    @db.Timestamptz(3)
  dueAtRaw        String?      @db.VarChar(40)
  timezone        String?      @db.VarChar(128)
  processingModel String?      @db.VarChar(256)
  summary         String       @db.Text
  body            String       @db.Text
  originalInput   String       @db.Text
  sourcePath      String       @db.Text
  sourceRevision  String       @db.VarChar(128)
  contentHash     String       @db.Char(64)
  canonicalPath   String?      @db.Text
  state           ImportState  @default(PERSISTED)
  removedAt       DateTime?    @db.Timestamptz(3)
  removedBy       String?      @db.VarChar(128)
  archivedAt      DateTime?    @db.Timestamptz(3)
  archivedBy      String?      @db.VarChar(128)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  attempts        ProcessingAttempt[]
  chunks          NoteChunk[]
  jobs            DbProcessingJob[]
  tagOverride     NoteTagOverride?
  researchReports ResearchReport[]
  taskSources     TaskSource[]

  @@unique([id, ownerSubject])
  @@unique([sourcePath, sourceRevision])
  @@unique([id, ownerSubject, captureId])
  @@index([ownerSubject, capturedAt])
  @@index([captureId])
  @@index([state])
  @@index([ownerSubject, removedAt])
  @@index([ownerSubject, archivedAt])
  @@map("notes")
}

enum AttemptStatus {
  PENDING
  LEASED
  PERSISTED
  FINALIZED
  RETRY
  REJECTED
}

// Issue #10 owns lease acquisition, retry transitions and reconciliation.
// The table is durable already; never use an in-memory lock as a substitute.
model ProcessingAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  sourcePath     String        @db.Text
  sourceRevision String        @db.VarChar(128)
  noteId         String?       @db.VarChar(36)
  note           Note?         @relation(fields: [noteId], references: [id], onDelete: SetNull)
  status         AttemptStatus @default(PENDING)
  attemptCount   Int           @default(0)
  leaseOwner     String?       @db.VarChar(128)
  leaseUntil     DateTime?     @db.Timestamptz(3)
  nextRetryAt    DateTime?     @db.Timestamptz(3)
  lastErrorCode  String?       @db.VarChar(64)
  committedAt    DateTime?     @db.Timestamptz(3)
  finalizedAt    DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([sourcePath, sourceRevision])
  @@index([status, nextRetryAt])
  @@index([leaseUntil])
  @@map("processing_attempts")
}

// Opaque scope hash includes backend, repository, branch and verified owner.
// A scan checkpoint proves durable discovery, not that every note imported.
model IngestionCheckpoint {
  key                   String    @id @db.Char(64)
  cursor                String?   @db.Text
  version               Int       @default(0)
  lastScanAt            DateTime? @db.Timestamptz(3)
  observedRevision      String?   @db.VarChar(64)
  reconciledRevision    String?   @db.VarChar(64)
  reconciledAt          DateTime? @db.Timestamptz(3)
  reconciliationPending Boolean   @default(true)
  knownNoteIds          String[]  @default([])
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@map("ingestion_checkpoints")
}

enum EmbeddingStatus {
  PENDING
  LEASED
  READY
  RETRY
  FAILED
}

// Materialized only from an owner-verified, committed note. The composite FK
// prevents a chunk from claiming another note's owner, even through raw SQL.
// Null-owned legacy notes cannot be indexed until an authorized migration.
model NoteChunk {
  id              String           @id @db.Char(64)
  noteId          String           @db.VarChar(36)
  ownerSubject    String           @db.VarChar(128)
  note            Note             @relation(fields: [noteId, ownerSubject], references: [id, ownerSubject], onDelete: Cascade, onUpdate: Restrict)
  sourceRevision  String           @db.VarChar(128)
  noteContentHash String           @db.Char(64)
  chunkerVersion  String           @db.VarChar(64)
  section         String           @db.VarChar(24)
  ordinal         Int
  startOffset     Int
  endOffset       Int
  contentHash     String           @db.Char(64)
  text            String           @db.Text
  embeddings      ChunkEmbedding[]
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([noteId, chunkerVersion, section, ordinal])
  @@index([ownerSubject, noteId])
  @@map("note_chunks")
}

// Provider execution is future issue #47. Vector is deliberately inaccessible
// via Prisma's regular CRUD API; later writers must use bounded, validated SQL.
// The first storage contract fixes 1536 dimensions until a reviewed migration.
model ChunkEmbedding {
  id            String            @id @db.Char(64)
  chunkId       String            @db.Char(64)
  chunk         NoteChunk         @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  provider      String            @db.VarChar(64)
  modelId       String            @db.VarChar(128)
  dimensions    Int
  status        EmbeddingStatus   @default(PENDING)
  vector        Unsupported("vector(1536)")?
  attemptCount  Int               @default(0)
  leaseOwner    String?           @db.VarChar(128)
  leaseUntil    DateTime?         @db.Timestamptz(3)
  nextRetryAt   DateTime?         @db.Timestamptz(3)
  lastErrorCode String?           @db.VarChar(64)
  indexedAt     DateTime?         @db.Timestamptz(3)
  usageTokens   Int?
  estimatedCostNanoUsd BigInt?
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([chunkId, modelId, dimensions])
  @@index([status, nextRetryAt])
  @@map("chunk_embeddings")
}

// Conservative reservations survive retries, crashes and chunk deletion.
model EmbeddingDailyBudget {
  ownerSubject   String   @db.VarChar(128)
  day            DateTime @db.Date
  reservedTokens Int      @default(0)
  requestCount   Int      @default(0)

  @@id([ownerSubject, day])
  @@map("embedding_daily_budgets")
}

// The rate window is independent of UTC-day reset; checkpoints contain no text.
model EmbeddingScan {
  ownerSubject    String   @id @db.VarChar(128)
  afterNoteId     String?  @db.VarChar(36)
  windowStartedAt DateTime @default(now()) @db.Timestamptz(3)
  windowRequests  Int      @default(0)

  @@map("embedding_scans")
}

// Single-user sessions and delegated API grants. Only digests are persisted.
model AuthSession {
  id                String   @id @default(uuid()) @db.Uuid
  ownerSubject      String   @db.VarChar(128)
  issuer            String   @db.VarChar(256)
  audience          String   @db.VarChar(256)
  tokenHash         String   @unique @db.Char(64)
  csrfHash          String   @db.Char(64)
  expiresAt         DateTime @db.Timestamptz(3)
  absoluteExpiresAt DateTime @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  lastSeenAt        DateTime @default(now()) @db.Timestamptz(3)
  grants            ApiGrant[]
  oauthCodes        OAuthCode[]

  @@index([ownerSubject, expiresAt])
  @@map("auth_sessions")
}

model ApiGrant {
  id                String   @id @default(uuid()) @db.Uuid
  sessionId         String   @db.Uuid
  session           AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clientId          String   @db.VarChar(128)
  audience          String   @db.VarChar(256)
  scopes            String[]
  accessHash        String   @unique @db.Char(64)
  refreshHash       String   @unique @db.Char(64)
  expiresAt         DateTime @db.Timestamptz(3)
  // Null only for explicitly consented, persistent OAuth connections.
  refreshExpiresAt DateTime? @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)

  @@index([sessionId])
  @@map("api_grants")
}

model ApiCaptureReceipt {
  id String @id @default(uuid()) @db.Uuid
  ownerSubject String @db.VarChar(128)
  idempotencyHash String @db.Char(64)
  payloadHash String @db.Char(64)
  noteIds String[]
  markdowns Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([ownerSubject, idempotencyHash])
  @@map("api_capture_receipts")
}

model DbProcessingJob {
  id String @id @default(uuid()) @db.Uuid
  ownerSubject String @db.VarChar(128)
  noteId String @db.VarChar(36)
  note Note @relation(fields:[noteId,ownerSubject],references:[id,ownerSubject],onDelete:Cascade,onUpdate:Restrict)
  sourceRevision String @db.VarChar(128)
  status String @default("PENDING") @db.VarChar(24)
  attemptCount Int @default(0)
  leaseOwner String? @db.VarChar(128)
  leaseUntil DateTime? @db.Timestamptz(3)
  nextRetryAt DateTime? @db.Timestamptz(3)
  lastErrorCode String? @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([noteId,sourceRevision])
  @@index([ownerSubject,status,nextRetryAt])
  @@map("db_processing_jobs")
}

// One-use PKCE codes. No authorization code, verifier or bearer plaintext stored.
model OAuthCode {
  codeHash String @id @db.Char(64)
  sessionId String @db.Uuid
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clientId String @db.VarChar(128)
  redirectUri String @db.VarChar(2048)
  resource String @db.VarChar(256)
  scopes String[]
  challenge String @db.Char(43)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("oauth_codes")
}

// Owner-curated vocabulary. No foreign key to note tags: approval never rewrites
// immutable source tags and approved entries may have zero note associations.
model TagApproval {
  ownerSubject String   @db.VarChar(128)
  slug         String   @db.VarChar(64)
  displayName  String?  @db.VarChar(120)
  description  String?  @db.VarChar(500)
  approvedBy   String   @default("owner") @db.VarChar(24)
  approvedAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@id([ownerSubject, slug])
  @@map("tag_approvals")
}

// A stable, monotonically increasing owner-scoped registry revision used by
// future opt-in exporters; note imports and facet reads do not advance it.
model TagRegistryRevision {
  ownerSubject String   @id @db.VarChar(128)
  revision     Int      @default(0)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@map("tag_registry_revisions")
}

// Mutable, owner-only note-local tag adjustments. Note.tags remains an
// immutable projection of Markdown v1; reimports never erase these overrides.
model NoteTagOverride {
  noteId       String   @id @db.VarChar(36)
  ownerSubject String   @db.VarChar(128)
  note         Note     @relation(fields: [noteId, ownerSubject], references: [id, ownerSubject], onDelete: Cascade, onUpdate: Restrict)
  added        String[] @default([])
  removed      String[] @default([])
  revision     Int      @default(0)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([noteId, ownerSubject])
  @@index([ownerSubject])
  @@map("note_tag_overrides")
}


// Coalesced, owner-scoped taxonomy export intent. Not a DbProcessingJob:
// there is no note ID and no dependency on private capture or embeddings.
model TagSnapshotOutbox {
  ownerSubject      String    @id @db.VarChar(128)
  desiredRevision   Int       @default(0)
  publishedRevision Int       @default(-1)
  publishedHash     String?   @db.Char(64)
  publishedAt       DateTime? @db.Timestamptz(3)
  status            String    @default("PENDING") @db.VarChar(24)
  attemptCount      Int       @default(0)
  leaseOwner        String?   @db.VarChar(128)
  leaseUntil        DateTime? @db.Timestamptz(3)
  nextRetryAt       DateTime? @db.Timestamptz(3)
  lastErrorCode     String?   @db.VarChar(64)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, nextRetryAt])
  @@map("tag_snapshot_outbox")
}

// Immutable owner-scoped research revisions, never part of Markdown v1. A
// report uses its parent note's composite owner FK and never rewrites the note.
model ResearchReport {
  id                 String   @id @db.VarChar(36)
  ownerSubject       String   @db.VarChar(128)
  parentNoteId       String   @db.VarChar(36)
  note               Note     @relation(fields: [parentNoteId, ownerSubject], references: [id, ownerSubject], onDelete: Restrict, onUpdate: Restrict)
  captureId          String   @db.VarChar(36)
  seriesId           String   @db.VarChar(36)
  revision           Int
  supersedesReportId String?  @db.VarChar(36)
  title              String   @db.VarChar(200)
  researchedAt       DateTime @db.Timestamptz(3)
  status             String   @db.VarChar(16)
  contextOutcome     String   @db.VarChar(40)
  artifact           Json
  contentHash        String   @db.Char(64)
  sourcePath         String   @db.Text
  sourceRevision     String   @db.VarChar(128)
  origin             String   @db.VarChar(12)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  chunks ResearchChunk[]

  @@unique([id, ownerSubject])
  @@unique([seriesId, revision])
  @@unique([sourcePath, sourceRevision])
  @@index([ownerSubject, parentNoteId, researchedAt])
  @@map("research_reports")
}

model ResearchChunk {
  id                String              @id @db.Char(64)
  reportId          String              @db.VarChar(36)
  ownerSubject      String              @db.VarChar(128)
  report            ResearchReport      @relation(fields: [reportId, ownerSubject], references: [id, ownerSubject], onDelete: Cascade, onUpdate: Restrict)
  sourceRevision    String              @db.VarChar(128)
  reportContentHash String              @db.Char(64)
  chunkerVersion    String              @db.VarChar(64)
  section           String              @db.VarChar(24)
  ordinal           Int
  startOffset       Int
  endOffset         Int
  contentHash       String              @db.Char(64)
  text              String              @db.Text
  embeddings        ResearchEmbedding[]
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([reportId, chunkerVersion, section, ordinal])
  @@index([ownerSubject, reportId])
  @@map("research_chunks")
}

// Provider execution is future issue #47. Vector is deliberately inaccessible
// via Prisma's regular CRUD API; later writers must use bounded, validated SQL.
// The first storage contract fixes 1536 dimensions until a reviewed migration.
model ResearchEmbedding {
  id                   String                       @id @db.Char(64)
  chunkId              String                       @db.Char(64)
  chunk                ResearchChunk                @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  provider             String                       @db.VarChar(64)
  modelId              String                       @db.VarChar(128)
  dimensions           Int
  status               EmbeddingStatus              @default(PENDING)
  vector               Unsupported("vector(1536)")?
  attemptCount         Int                          @default(0)
  leaseOwner           String?                      @db.VarChar(128)
  leaseUntil           DateTime?                    @db.Timestamptz(3)
  nextRetryAt          DateTime?                    @db.Timestamptz(3)
  lastErrorCode        String?                      @db.VarChar(64)
  indexedAt            DateTime?                    @db.Timestamptz(3)
  usageTokens          Int?
  estimatedCostNanoUsd BigInt?
  createdAt            DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(3)

  @@unique([chunkId, modelId, dimensions])
  @@index([status, nextRetryAt])
  @@map("research_embeddings")
}

// Durable per-artifact observations. Parent IDs are untrusted until validated;
// readers must additionally verify the parent belongs to the authenticated owner.
model ResearchIngressAttempt {
  id             String    @id @db.Char(64)
  checkpointKey  String    @db.Char(64)
  ownerSubject   String    @db.VarChar(128)
  sourcePath     String    @db.Text
  sourceRevision String    @db.VarChar(128)
  parentNoteId   String?   @db.VarChar(36)
  status         String    @db.VarChar(24)
  attemptCount   Int       @default(0)
  nextRetryAt    DateTime? @db.Timestamptz(3)
  lastErrorCode  String?   @db.VarChar(64)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([ownerSubject, parentNoteId])
  @@map("research_ingress_attempts")
}

// Independent records: Markdown kind/tags never create or complete a Task.
model Task {
  id           String @id @db.VarChar(36)
  ownerSubject String @db.VarChar(128)
  title        String @db.VarChar(200)
  description  String? @db.Text
  status       TaskStatus @default(OPEN)
  revision     Int @default(1)
  completedAt  DateTime? @db.Timestamptz(3)
  origin       String @db.VarChar(12)
  creationHash String @db.Char(64)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  sources      TaskSource[]
  events       TaskEvent[]
  commands     TaskCommand[]

  @@unique([id, ownerSubject])
  @@index([ownerSubject, status, createdAt, id])
  @@map("tasks")
}

enum TaskStatus {
  OPEN
  COMPLETED
}

model TaskSource {
  taskId       String @db.VarChar(36)
  noteId       String @db.VarChar(36)
  ownerSubject String @db.VarChar(128)
  captureId    String @db.VarChar(36)
  evidence     String? @db.Text
  task Task @relation(fields: [taskId, ownerSubject], references: [id, ownerSubject], onDelete: Restrict, onUpdate: Restrict)
  note Note @relation(fields: [noteId, ownerSubject, captureId], references: [id, ownerSubject, captureId], onDelete: Restrict, onUpdate: Restrict)

  @@id([taskId, noteId])
  @@index([ownerSubject, noteId])
  @@map("task_sources")
}

model TaskEvent {
  taskId       String @db.VarChar(36)
  ownerSubject String @db.VarChar(128)
  revision     Int
  type         String @db.VarChar(24)
  status       TaskStatus
  at           DateTime @default(now()) @db.Timestamptz(3)
  task Task @relation(fields: [taskId, ownerSubject], references: [id, ownerSubject], onDelete: Restrict, onUpdate: Restrict)

  @@id([taskId, revision])
  @@map("task_events")
}

// Retry receipts survive subsequent lifecycle transitions, including reopen.
model TaskCommand {
  ownerSubject String @db.VarChar(128)
  id           String @db.VarChar(36)
  taskId       String @db.VarChar(36)
  payloadHash  String @db.Char(64)
  task Task @relation(fields: [taskId, ownerSubject], references: [id, ownerSubject], onDelete: Restrict, onUpdate: Restrict)

  @@id([ownerSubject, id])
  @@map("task_commands")
}
