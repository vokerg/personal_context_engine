[Unit]
Description=PCE background queue worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=pce-worker
Group=pce-worker
WorkingDirectory=/opt/pce/current/apps/worker
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=96
EnvironmentFile=/etc/pce/worker.env
ExecStart=/opt/pce/current/runtime/node /opt/pce/current/apps/worker/dist/main.js
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=120
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pce-worker
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
MemoryHigh=160M
MemoryMax=192M
MemorySwapMax=0
CPUQuota=25%
TasksMax=32
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pce
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
# Use a minimally privileged/no attached VM service account. The guest DNS
# resolver can share the metadata IP, so do not block that whole address here.

[Install]
WantedBy=multi-user.target
