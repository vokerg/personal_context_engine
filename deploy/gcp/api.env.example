# Example ONLY. Copy to root-owned /etc/pce/api.env, mode 0600.
# Initial stage: independent API is reachable on VM loopback only.
NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=3112
API_REQUIRE_DB=true
# Use an API-specific least-privilege DB role, with a low connection_limit.
DATABASE_URL=REPLACE_WITH_API_DATABASE_URL
PCE_AUTH_MODE=single-user
PCE_OWNER_SUBJECT=REPLACE_WITH_EXISTING_OWNER
PCE_SINGLE_USER_USERNAME=REPLACE_WITH_USERNAME
PCE_SINGLE_USER_PASSWORD_HASH=REPLACE_WITH_SCRYPT_V1_HASH
# Same canonical hostname is required by PCE single-user OAuth.
# These are placeholders during a loopback-only readiness phase.
PCE_WEB_ORIGIN=https://personal-context-engine-web.vercel.app
PCE_API_ORIGIN=https://personal-context-engine-web.vercel.app
PCE_DB_SEARCH=true
PCE_MCP_ENABLED=false
PCE_TASKS_ENABLED=false
PCE_TASK_SUGGESTIONS_ENABLED=false
PCE_RESEARCH_REPORTS=false
PCE_GITHUB_FETCH_ENABLED=false
PCE_EMBEDDINGS_ENABLED=false
# MCP needs a separately reviewed HTTPS route and explicit test OAuth grant.
# PCE_OAUTH_CLIENTS=[...]
# PCE_MCP_TRANSPORT_ORIGIN=https://your-verified-public-transport
