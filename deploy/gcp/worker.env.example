# Root-owned /etc/pce/worker.env, 0600. systemd syntax; never shell-source it.
# Configure a dedicated runtime DB login, never schema-owner/migration credentials.
DATABASE_URL=REPLACE_WITH_RUNTIME_DATABASE_URL
PCE_OWNER_SUBJECT=REPLACE_WITH_EXISTING_PERSISTED_OWNER
WORKER_MODE=db-jobs-loop
# Deterministic DB preparation only by default. No GitHub or OpenAI egress.
PCE_TASK_INGRESS_ENABLED=false
PCE_RESEARCH_INGRESS_ENABLED=false
PCE_TAG_SNAPSHOT_ENABLED=false
PCE_EMBEDDINGS_ENABLED=false
# Separately enable existing features after scope, credentials and egress checks.
# PCE_TASK_INGRESS_REPOSITORY=owner/private-content
# PCE_TASK_INGRESS_BRANCH=main
# PCE_TASK_INGRESS_TOKEN=REPLACE_WITH_CONTENTS_READ_TOKEN
# PCE_RESEARCH_INGRESS_REPOSITORY=owner/private-content
# PCE_RESEARCH_INGRESS_BRANCH=main
# PCE_RESEARCH_INGRESS_TOKEN=REPLACE_WITH_CONTENTS_READ_TOKEN
# PCE_TAG_SNAPSHOT_ALLOW_WRITES=I_VERIFIED_PRIVATE_REPOSITORY
# PCE_TAG_SNAPSHOT_REPOSITORY=owner/private-content
# PCE_TAG_SNAPSHOT_BRANCH=main
# PCE_TAG_SNAPSHOT_TOKEN=REPLACE_WITH_CONTENTS_WRITE_TOKEN
