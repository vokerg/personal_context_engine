{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pce-gcp-reserve",
  "main": "edge-proxy.mjs",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_ORIGIN": "https://reserve.example.invalid",
    "UPSTREAM_ORIGIN": "https://gcp-origin.example.invalid"
  }
}
