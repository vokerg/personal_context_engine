# Public-only API defaults to loopback. Never put secrets in this file.
API_HOST=127.0.0.1
API_PORT=3000
# Optional one-origin browser development CORS:
# API_CORS_ORIGIN=http://127.0.0.1:4200
# Local disposable DB only; never commit real credentials:
# DATABASE_URL=postgresql://pce:pce_dev_only@127.0.0.1:5432/pce?schema=public
# API_REQUIRE_DB=true  # Requires live PostgreSQL; startup fails closed otherwise.

# Production requires issuer/audience and exactly ONE verification method.
# API_AUTH_ISSUER=pce-trusted-issuer
# API_AUTH_AUDIENCE=pce-api
# For legacy/dev HS256; configure the symmetric key in a secret manager:
# API_AUTH_HS256_SECRET=<server-only-random-key-at-least-32-bytes>
# OR use pinned RS256 issuer verification (no private signing key in API):
# API_AUTH_RS256_KEY_ID=issuer-key-1
# API_AUTH_RS256_PUBLIC_KEY_PEM=<trusted-issuer-SPKI-RSA-public-key-PEM>
# Provide multiline PEM via a trusted environment/secret manager, never in git.
# Tokens carrying jku/jwk/x5u/x5c cannot substitute a key.
# This does not add login, OAuth/PKCE, revocation or production note routes.

# Worker remains inert until WORKER_MODE=once is explicitly selected.
# WORKER_MODE=once
# WORKER_CONTENT_BACKEND=filesystem
# WORKER_CONTENT_ROOT=/absolute/path/to/disposable-synthetic-sandbox
# For trusted private GitHub ingestion only (never public CI):
# WORKER_CONTENT_BACKEND=github
# WORKER_ALLOW_GITHUB_WRITES=I_VERIFIED_PRIVATE_REPOSITORY
# CONTENT_REPOSITORY=owner/verified-private-content-repo
# CONTENT_BRANCH=main
# CONTENT_GITHUB_TOKEN=<runtime-secret-not-committed>

# Public client endpoints only (never bearer tokens or server signing keys).
# VITE_API_BASE_URL=http://127.0.0.1:3000
# EXPO_PUBLIC_API_BASE_URL=https://your-device-reachable-development-api.example
# Expo on physical devices cannot use the host computer's "localhost".

# Explicit local workspace launcher: npm run dev:local
# PCE_CONTENT_ROOT=../personal_context_engine_content
# PCE_WEB_PORT=4310
# API_PORT=3110
# Requires DATABASE_URL; all local services bind to 127.0.0.1.

# Opt into the real GitHub ingestion worker within dev:local (30-second polls).
# PCE_INGEST_GITHUB=true
# CONTENT_REPOSITORY=owner/verified-private-content-repo
# CONTENT_BRANCH=main
# Uses CONTENT_GITHUB_TOKEN if set; otherwise existing local `gh auth`.
# No GitHub token is sent to the browser or public CI.

# Embedding worker remains disabled without a deliberate, separate egress approval.
PCE_EMBEDDINGS_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Dedicated PCE development project and restricted server-side key:
# OPENAI_PROJECT_ID=proj_your_project_id
# OPENAI_API_KEY=replace_only_in_ignored_local_env
# Never use VITE_* or EXPO_PUBLIC_* for provider credentials.
# WORKER_MODE=embeddings-once # standalone, finite server-side indexing pass only
# PCE_EMBEDDING_EGRESS_APPROVED=I_APPROVE_PRIVATE_TEXT_TO_OPENAI
# PCE_EMBEDDING_OWNER_SUBJECT=trusted-persisted-owner
# PCE_EMBEDDING_AFTER_NOTE_ID=optional-manual-keyset-override
# npm run embeddings:once  # after build + migrations; loads ignored root .env
# DB-enforced per owner: <=4 claims/60-second window, <=60k reserved tokens/UTC day.
# Each attempt conservatively reserves input UTF-8 bytes + 16 (at most 8192), including failures/crashes.
# npm run openai:check         # offline config check
# npm run openai:check -- --live  # explicit read-only model metadata request

# Explicit opt-in local DB browsing; legacy preview remains the default.
# PCE_LOCAL_BROWSE=true
# Enables bounded pages, literal full-note search and observed project/kind facets.
# Does not change ChatGPT repository search or enable hybrid retrieval/embeddings.

# SportOS-compatible single-user sessions. Leave unset for legacy API defaults.
# PCE_AUTH_MODE=dev-single-user # local loopback only; forbidden in production
# PCE_AUTH_MODE=single-user     # password login; HTTPS outside local development
# PCE_OWNER_SUBJECT=local-developer # trusted persisted owner; never a client field
# PCE_WEB_ORIGIN=http://127.0.0.1:4310
# PCE_API_ORIGIN=http://127.0.0.1:3110
# PCE_SINGLE_USER_USERNAME=
# PCE_SINGLE_USER_PASSWORD_HASH=scrypt-v1:<salt-hex>:<derived-key-hex>

# Explicit authenticated DB search; includes the local paged browse UI.
# PCE_DB_SEARCH=true
# Semantic queries additionally require the separate embedding egress approval.
# Missing/disabled/provider-failed embeddings fall back to DB keywords.

# Research reports: DB API, web detail/history and labelled research retrieval. OFF.
# Requires configured PostgreSQL + authenticated sessions.
# PCE_RESEARCH_REPORTS=false
# Hosted Vite builds also need VITE_PCE_RESEARCH_REPORTS=true for the research panel.
# dev:local injects the browser flag from PCE_RESEARCH_REPORTS.

# Research JSON inbox reader on the EXISTING db-jobs-once/db-jobs-loop worker. OFF.
# PCE_RESEARCH_INGRESS_ENABLED=false
# PCE_RESEARCH_INGRESS_REPOSITORY=owner/verified-private-content-repo
# PCE_RESEARCH_INGRESS_BRANCH=main
# PCE_RESEARCH_INGRESS_TOKEN=<dedicated-private-read-only-secret>
# Requires PCE_OWNER_SUBJECT + DATABASE_URL and private repository verification.
# It imports existing validated JSON; it NEVER generates research or writes to GitHub.
# See docs/20-research-capture.md; enable only after separate private contract rollout.

# Optional MCP / OAuth, same single-user login. Off by default.
# Requires explicit sessions and PCE_DB_SEARCH=true. Exact registered callbacks only.
# PCE_MCP_ENABLED=true
# Optional trusted reverse-proxy transport origin; never derived from request headers.
# PCE_MCP_TRANSPORT_ORIGIN=https://personal-context-engine-api.onrender.com
# PCE_OAUTH_CLIENTS=[{"clientId":"local-mcp-test","redirectUris":["http://127.0.0.1:3001/callback"],"scopes":["notes:read","capture:write"]}]

# Optional notes:read MCP explainability tool; requires MCP + DB search.
# Query embeddings still require the independent provider/egress gates above.
PCE_SEARCH_DIAGNOSTICS=false

# Optional owner-approved tag projection to the private content repository.
# Disabled by default; no note capture, embeddings or worker scheduling dependency.
# WORKER_MODE=db-jobs-once    # finite; processes preparation and approved tags
# WORKER_MODE=db-jobs-loop    # separately opted-in minute pass, no OpenAI egress
# PCE_OWNER_SUBJECT=trusted-persisted-owner
# PCE_TAG_SNAPSHOT_ENABLED=false
# PCE_TAG_SNAPSHOT_ALLOW_WRITES=I_VERIFIED_PRIVATE_REPOSITORY
# PCE_TAG_SNAPSHOT_REPOSITORY=owner/verified-private-content-repo
# PCE_TAG_SNAPSHOT_BRANCH=main
# PCE_TAG_SNAPSHOT_TOKEN=<dedicated-trusted-publisher-secret-not-capture-token>
# See docs/21-tag-snapshot.md. Do not enable until public and private PRs are reviewed.
