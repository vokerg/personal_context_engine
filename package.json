{
  "name": "personal-context-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/core",
    "packages/contracts",
    "packages/api-client",
    "packages/db",
    "apps/api",
    "apps/worker",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:local": "node scripts/local-dev.mjs",
    "dev": "concurrently -k -n api,worker,web \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:api": "npm run build -w @pce/contracts && npm run dev -w @pce/api",
    "dev:worker": "npm run dev -w @pce/worker",
    "dev:web": "npm run dev -w @pce/web",
    "dev:mobile": "npm run start -w @pce/mobile",
    "build": "npm run prisma:generate && npm run build --workspaces --if-present",
    "test": "npm run build && vitest run",
    "lint": "eslint apps packages",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,tsx,json}\" \"*.{json,mjs}\"",
    "typecheck": "npm run prisma:generate && npm run build -w @pce/core && npm run build -w @pce/contracts && npm run build -w @pce/api-client && npm run build -w @pce/db && npm run typecheck --workspaces --if-present",
    "docs:check": "node scripts/check-docs.mjs",
    "prisma:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:validate": "prisma validate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "capture:verify": "npm run build -w @pce/core && node scripts/verify-chatgpt-capture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.10",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.10",
    "vitest": "^3.2.4",
    "prisma": "6.19.1"
  }
}
